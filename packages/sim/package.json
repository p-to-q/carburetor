{
  "name": "@carburetor/sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "carburetor — the simulator. five layers, two surfaces.",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/sim.browser.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "echo 'browser playable TBD — see ../../ROADMAP.md v0.2' && exit 0",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "headless": "pnpm build && node -e \"import('./dist/index.js').then(({runHeadless,coldStartEvents}) => console.log(JSON.stringify(runHeadless(coldStartEvents(5), 80).at(-1), null, 2)))\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  }
}
